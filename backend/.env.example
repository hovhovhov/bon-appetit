# Copy this file to .env.local. Leave secrets on your computer only.
# Allowed provider modes: stub or openai.
AI_PROVIDER_MODE=

# Required only for openai mode. Never paste this value into source control or chat.
OPENAI_API_KEY=

# Responses API model selected at runtime.
OPENAI_MODEL=

# Local bind address. Use loopback for Simulator development.
BACKEND_HOST=

# Local HTTP port.
BACKEND_PORT=

# Provider request timeout in milliseconds.
AI_REQUEST_TIMEOUT_MS=

# Maximum Responses API output tokens per request.
AI_MAX_OUTPUT_TOKENS=

# Maximum eligible catalogue candidates sent to a provider.
AI_MAX_CANDIDATES=

# Local route requests allowed per minute per client.
BACKEND_RATE_LIMIT_PER_MINUTE=

# Identical personalization-result cache lifetime in seconds.
AI_CACHE_TTL_SECONDS=

# Local test behavior: normal or invalid-recommendations. Never use outside local validation.
BACKEND_TEST_SCENARIO=
